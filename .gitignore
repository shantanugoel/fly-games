# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.local

# Trained readouts. Regenerate with `fly-games train`; the .npz is a few
# hundred KB of fitted weights and the .json says which labels they were
# fitted against, so a stale file fails loudly instead of mislabelling
# decisions. Kept out of git so nobody inherits someone else's fly.
readouts/

# Cartridges. Commercial ROMs and IWADs are not redistributable -- see
# roms/README.md for where to put your own.
roms/*.nes
roms/*.wad
roms/*.zip
!roms/README.md

# The connectome itself (~260 MB, downloaded by `fly-games brain-download`).
fly-data/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# Generated by ViZDoom the first time Doom is played.
_vizdoom.ini

# Editors and OS
.idea/
.vscode/
.DS_Store
*.swp
logs/
*.log