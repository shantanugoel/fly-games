# Copy to .env and edit. Loaded by every `fly-games` command.
# Nothing here is a secret; nothing here is required either — the defaults
# below are what the code uses when a variable is absent.

# ---------------------------------------------------------------- fly brain
# Where the MaleCNS connectome lives. Created by `fly-games brain-download`.
FLY_DATA=~/fly-data

# cpu or cuda. MPS is not supported by the spiking solver.
FLY_DEVICE=cpu

# Force the zero-shot rule everywhere, even where a readout has been trained.
# Useful for A/B-ing a trained readout against the hand-written decoder.
FLY_HAND_POLICY=0

# ---------------------------------------------------------------- lab server
FLY_GAMES_HOST=127.0.0.1
FLY_GAMES_PORT=8000

# Which title the lab opens on: mario, kungfu or doom.
FLY_GAMES_GAME=mario

# ---------------------------------------------------------------- readouts
# Where fitted readouts are saved and loaded from.
FLY_GAMES_READOUTS=readouts

# ---------------------------------------------------------------- cartridges
# Commercial ROMs are not in this repository. Point at a legally obtained copy
# (or just drop it in roms/ and leave these unset).
# KUNGFU_NES=~/roms/kungfu.nes
# DOOM_IWAD=~/roms/doom1.wad

# Alternate variable names are honoured too, so a shared roms/ directory works
# across projects: FLY_KUNGFU_ROM / JEV_KUNGFU_ROM, FLY_DOOM_IWAD / JEV_DOOM_IWAD.

# ---------------------------------------------------------------- frontend
# Where `bun run dev` (port 5173) proxies /api and /ws to. Only needed if the
# lab is not on 127.0.0.1:8000.
# FLY_GAMES_BACKEND=http://127.0.0.1:8000